<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Exclude encrypted secure storage: restoring ciphertext without the
         Android Keystore key makes tokens undecryptable and triggers logout. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </device-transfer>
</data-extraction-rules>
